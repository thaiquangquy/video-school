# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# app data — local db, downloaded videos, generated thumbnails
/data/app.db
/data/app.db-journal
/data/app.db-wal
/data/app.db-shm
/data/videos/*
!/data/videos/.gitkeep
/data/thumbnails/*
!/data/thumbnails/.gitkeep

# playwright e2e — fixture db is regenerated by global-setup on every run,
# saved login storage state is a live session cookie, not a source file
/e2e/fixtures/data/app.db*
/e2e/.auth/
/playwright-report/
/test-results/
/blob-report/
