# Mode selection — "sqlite" (default, local-only) or "supabase" (cloud, multi-account)
DATA_BACKEND=sqlite

# --- local mode (DATA_BACKEND=sqlite) ---
APP_PASSWORD=
SESSION_SECRET=

# --- cloud mode (DATA_BACKEND=supabase) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- e2e/test isolation only — leave unset for normal dev/Docker usage.
# Overrides the hardcoded data/app.db, data/lessons.yaml, data/config.yaml
# paths so Playwright can run against fixture data. See playwright.config.ts.
DB_PATH=
LESSONS_MANIFEST_PATH=
APP_CONFIG_PATH=
